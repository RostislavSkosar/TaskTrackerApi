meta {
  name: Созданный комментарий по Id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/comments/{{createdCommentId}}
  body: none
  auth: inherit
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("автор совпадает", function() {
    expect(res.getBody().author).to.equal('Скосарь Р.А.');
  });
}
