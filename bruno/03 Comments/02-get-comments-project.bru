meta {
  name: Комментарии проекта 1 (объединение 3 сущностей)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/comments?projectId=1
  body: none
  auth: inherit
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("у каждого комментария есть код проекта", function() {
    res.getBody().forEach(c => expect(c.projectCode).to.equal('SHOP'));
  });
}
