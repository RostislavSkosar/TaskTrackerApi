meta {
  name: Обновить созданный проект
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/projects/{{createdProjectId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Портал университета v2",
    "priority": "High"
  }
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("имя обновлено", function() {
    expect(res.getBody().name).to.equal('Портал университета v2');
  });
  test("приоритет High", function() {
    expect(res.getBody().priority).to.equal('High');
  });
}
