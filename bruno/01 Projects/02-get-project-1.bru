meta {
  name: Проект по Id (SHOP)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/projects/1
  body: none
  auth: inherit
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("код проекта SHOP", function() {
    expect(res.getBody().code).to.equal('SHOP');
  });
  test("есть расчётный процент выполнения", function() {
    expect(res.getBody().completionPercent).to.be.a('number');
  });
}
