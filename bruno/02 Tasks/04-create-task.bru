meta {
  name: Создать задачу в проекте 1 (201)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/tasks?projectId=1
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Кеширование каталога",
    "description": "Redis",
    "priority": "Medium",
    "assignee": "Скосарь Р.А.",
    "dueDateUtc": "2026-10-30T00:00:00Z"
  }
}

script:post-response {
  bru.setVar('createdTaskId', res.getBody().id);
}

tests {
  test("HTTP 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("статус Backlog", function() {
    expect(res.getBody().status).to.equal('Backlog');
  });
}
