meta {
  name: Перенести срок задачи 3
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/api/tasks/3/reschedule
  body: json
  auth: inherit
}

body:json {
  {
    "dueDateUtc": "2026-11-20T00:00:00Z",
    "reason": "перенос спринта"
  }
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("срок обновлён", function() {
    expect(res.getBody().dueDateUtc).to.be.a('string');
  });
}
