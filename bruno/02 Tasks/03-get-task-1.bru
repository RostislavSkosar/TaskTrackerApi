meta {
  name: Задача по Id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/tasks/1
  body: none
  auth: inherit
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("название задачи", function() {
    expect(res.getBody().title).to.equal('REST API каталога товаров');
  });
  test("проект подтянут (объединение)", function() {
    expect(res.getBody().projectCode).to.equal('SHOP');
  });
}
