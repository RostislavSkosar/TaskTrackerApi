meta {
  name: Доска исполнителя (join, синтаксис запросов LINQ)
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/tasks/my-board?assignee=%D0%A1%D0%BA%D0%BE%D1%81%D0%B0%D1%80%D1%8C
  body: none
  auth: inherit
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("есть задачи", function() {
    expect(res.getBody().length).to.be.at.least(1);
  });
  test("все задачи незакрытые", function() {
    res.getBody().forEach(t => expect(['Done','Cancelled']).to.not.include(t.status));
  });
}
